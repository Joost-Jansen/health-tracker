# health-tracker: copy to .env (git-ignored), fill in, keep a copy of the secrets in a password manager.
# Read by docker-compose.yml. Same section headings and shared variable names as stock-tracker's .env.example.

# --- Required secrets --------------------------------------------------------------------------------------------
# Signs session cookies; at least 32 characters. Changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
TRAINING_JWT_SECRET=
# Encrypts stored Garmin/Wahoo sessions and two-step login secrets (a Fernet key). Must stay the same: with another
# key every user reconnects Garmin/Wahoo and sets up two-step login again. New install:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Moving an install that never set it (or set TOKEN_ENCRYPTION_KEY, the older name, which is still read):
#   TRAINING_JWT_SECRET=<the old one> python -m tools.secretbox --print-derived-key
APP_ENCRYPTION_KEY=
# Password of the Postgres user `health` (only reachable inside the compose project).
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Public URL and proxy ------------------------------------------------------------------------------------------
# Origins (scheme://host[:port]) besides the request's own host that may send state-changing requests (the CSRF
# check), comma-separated; e.g. the public domain and the Tailscale name.
PUBLIC_ORIGINS=https://health.example.org,https://minipc.your-tailnet.ts.net
# Proxies whose CF-Connecting-IP / X-Forwarded-For are believed for the per-IP limits (IPs or CIDRs, comma-separated).
# The edge Caddy has a fixed address on the `edge` network (deploy/edge/docker-compose.yml). Empty: the socket peer.
TRUSTED_PROXIES=172.30.0.10
# The session cookie is Secure (https only). Only `false` for local http development.
COOKIE_SECURE=true
# Days a session stays valid after its last use (renewed while in use).
SESSION_DAYS=14
# Used in links (the feedback ping) when the site cannot tell its own address.
PUBLIC_URL=https://health.example.org

# --- Privacy -------------------------------------------------------------------------------------------------------
# Shown on /privacy as the controller of the users' data (GDPR) and how to reach them.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=

# --- Limits --------------------------------------------------------------------------------------------------------
# FIT uploads (MB).
MAX_UPLOAD_MB=25
# An Apple Health export (MB), and the parts the site uploads it in (MB, below Cloudflare's 100 MB request limit and
# the edge Caddy's limit for /api/apple/upload/*). Unfinished uploads are removed after APPLE_UPLOAD_TTL_MIN minutes.
APPLE_IMPORT_MAX_MB=2048
APPLE_CHUNK_MB=32
APPLE_UPLOAD_TTL_MIN=60

# --- Integrations --------------------------------------------------------------------------------------------------
# Wahoo (developers.wahooligan.com, scopes workouts_read offline_data user_read). Register the callback
# https://health.example.org/api/connections/wahoo/callback (phase A, site only over Tailscale: the ts.net URL).
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_REDIRECT_URI=
# An ntfy topic URL: a ping when someone sends feedback (only the kind and a link, never the text).
FEEDBACK_NTFY_URL=
# Daily Garmin/Wahoo sync inside the web service (06:00 Europe/Amsterdam).
SYNC_IN_WEB=true
TZ=Europe/Amsterdam

# --- Development only ----------------------------------------------------------------------------------------------
# `true` skips the start-up checks for secrets (missing APP_ENCRYPTION_KEY, a short JWT secret). Never in production.
ALLOW_INSECURE_DEFAULTS=false
# Optional bootstrap of the first admin on an empty database instead of registering in the browser (bcrypt hash).
TRAINING_USER=
TRAINING_PASSWORD_HASH=
